{
  "expo": {
    "name": "FogRadar",
    "slug": "fogradar",
    "scheme": "fogradar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fogradar.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FogRadar uses your precise location during an active journey to display nearby connected vehicles and motorway hazard advisories."
      }
    },
    "android": {
      "package": "com.fogradar.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#06472D"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FogRadar to access your precise location during an active journey to share live telemetry and show nearby vehicles.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#06472D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
