{
  "expo": {
    "name": "FogRadar",
    "slug": "fogradar",
    "scheme": "fogradar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fogradar.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FogRadar uses your precise location during an active journey to display nearby connected vehicles and motorway hazard advisories."
      }
    },
    "android": {
      "package": "com.devoxis.fogradar",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#06472D"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FogRadar to access your precise location during an active journey to share live telemetry and show nearby vehicles.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#06472D"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8dd4750c-6281-444b-b4c5-cd4466f61b2d"
      }
    }
  }
}
